# Database
DATABASE_URL=

# Authentication
NEXTAUTH_SECRET=
NEXTAUTH_URL=

JWT_SECRET=
TOKEN_EXPIRE=7d

# Kavenegar
KAVENEGAR_API_KEY=

# Zarinpal Payment
ZARINPAL_API_BASE_URL=https://payment.zarinpal.com/pg/v4/payment
ZARINPAL_PAYMENT_MERCHANT_ID=
ZARINPAL_PAYMENT_CALLBACK_URL=https://samaneyoga.ir/api/checkout/verify
ZARINPAL_PAYMENT_BASE_URL=https://payment.zarinpal.com/pg/StartPay/

# Storage (legacy - remove after migration)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=
AWS_S3_BUCKET_NAME=
AWS_S3_BASE_URL=

# Video Storage
VIDEO_STORAGE_DRIVER=local
LOCAL_VIDEO_ROOT=./storage/published
VIDEO_PUBLIC_BASE_URL=http://localhost:3000
VIDEO_PROCESSOR=local
VIDEO_UPLOAD_ROOT=./storage/uploads/jobs
MAX_SOURCE_VIDEO_BYTES=8589934592

FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

VIDEO_PROCESSING_ROOT=./storage/processing/jobs
VIDEO_OUTPUT_PREFIX=videos/sessions

# Application
NEXT_PUBLIC_API_BASE_URL=https://samaneyoga.ir

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://samaneyoga.ir/api/auth/google/callback

# Push Notification
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_ADMIN_PUSH_KEY=
ADMIN_PUSH_KEY=

# Postex
NEXT_PUBLIC_POSTEX_API_KEY=
POSTEX_BASE=https://api.postex.ir/api/v1

# Prisma
PRISMA_ENGINES_MIRROR=https://prisma.storage.iran.liara.site

# Video worker
VIDEO_WORKER_POLL_INTERVAL_MS=5000
VIDEO_WORKER_ERROR_DELAY_MS=10000

MAX_AUDIO_BYTES=536870912

MEDIA_STORAGE_DRIVER=local
LOCAL_MEDIA_ROOT=./storage/published
MEDIA_PUBLIC_BASE_URL=http://localhost:3000
MAX_IMAGE_BYTES=20971520
APP_PUBLIC_BASE_URL=http://localhost:3000

VIDEO_WORKER_MAX_ATTEMPTS=3
VIDEO_WORKER_HEARTBEAT_INTERVAL_MS=15000
VIDEO_WORKER_STALE_AFTER_MS=300000
VIDEO_WORKER_STALE_SCAN_INTERVAL_MS=60000

SESSION_MEDIA_TOKEN_SECRET=
SESSION_MEDIA_TOKEN_TTL_SECONDS=21600

# Logging
LOG_LEVEL=info
LOG_SERVICE=teaching-yoga-web

# در Production به‌صورت پیش‌فرض true در نظر گرفته می‌شود.
# برای جلوگیری از خروج Process بعد از Fatal Error مقدار false قرار بده.
LOG_EXIT_ON_FATAL=true

# OTP authentication
OTP_HASH_SECRET=
OTP_TTL_SECONDS=120
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=5
KAVENEGAR_TEMPLATE=samanehyoga

PAYMENT_GATEWAY_TIMEOUT_MS=12000
PAYMENT_PENDING_REUSE_SECONDS=900

# Discount reservation
DISCOUNT_RESERVATION_TTL_SECONDS=900
DISCOUNT_PAYMENT_RESERVATION_TTL_SECONDS=3600